# Supabase — copie para .env.local e preencha
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit Cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LiveKit Egress — gravação de reunião (opcional)
# Deixe LIVEKIT_EGRESS_ENABLED=false ou vazio para desabilitar gravação.
# Quando desabilitado, os endpoints /api/rooms/*/recording/* respondem 501
# e o botão de gravar não aparece na sala.
LIVEKIT_EGRESS_ENABLED=false

# Supabase Storage S3 endpoint (para o Egress fazer upload)
# Gere access keys em Supabase Dashboard → Settings → Storage → S3 Access Keys
# Crie o bucket `recordings` (privado) em Storage → New bucket
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=sa-east-1
SUPABASE_S3_BUCKET=recordings

# OpenAI — assistente CCO (gpt-4o-mini)
# Sem essa chave, o /api/chat responde 501 e a bolha fica visível
# mas não consegue responder. Chave começa com sk-proj- ou sk-.
OPENAI_API_KEY=

# CRON_TOKEN — protege /api/cron/rooms-sync e /api/cron/*.
# Gere uma string aleatória forte (ex: openssl rand -hex 32) e use
# no querystring do agendador: /api/cron/rooms-sync?token=<CRON_TOKEN>
CRON_TOKEN=
